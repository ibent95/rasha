# ============================================
# RASHA Super App — Docker Environment Configuration
# ============================================
# Copy this file to .env and adjust values.
#   cp .env.example .env && docker compose up -d

APP_NAME=RASHA
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Feature Flags
QUEUE_ENABLE=false
REDIS_ENABLE=false
MEMCACHED_ENABLE=false

# ---- Database (Local: PostgreSQL | Production: MySQL/MariaDB) ----
DB_CONNECTION=pgsql
DB_DATABASE=rasha_core_db
DB_USERNAME=rasha_user
DB_PASSWORD=rasha_secret_2024
DB_PORT_HOST=5432

# Service Ports
SVC_CORE_PORT=8400
SVC_AUTHORIZATION_PORT=8401
SVC_CRM_PORT=8402
SVC_DYNAMIC_FORM_PORT=8403
SVC_ERP_PORT=8404

# Website Ports
WEB_PORTAL_PORT=4400
WEB_CRM_PORT=4401
WEB_DYNAMIC_FORM_PORT=4402
WEB_ERP_PORT=4403

# ── Reverse Proxy ──
PROXY_PORT=80
PROXY_SSL_PORT=443

# CRM Database
CRM_DB_DATABASE=rasha_crm_db
CRM_DB_USERNAME=rasha_crm_user
CRM_DB_PASSWORD=rasha_crm_secret_2024

# Dynamic Form Database
DYNAMIC_FORM_DB_DATABASE=rasha_dynform_db
DYNAMIC_FORM_DB_USERNAME=rasha_dynform_user
DYNAMIC_FORM_DB_PASSWORD=rasha_dynform_secret_2024

# ERP Database
ERP_DB_DATABASE=rasha_erp_db
ERP_DB_USERNAME=rasha_erp_user
ERP_DB_PASSWORD=rasha_erp_secret_2024

# Redis
REDIS_PASSWORD=rasha_redis_2024
REDIS_PORT_HOST=6379

# Memcached
MEMCACHED_MEMORY_LIMIT=64
MEMCACHED_PORT_HOST=11211

# Docker Network
DOCKER_NETWORK_SUBNET=172.21.0.0/16

# ============================================
# Production (ibent95.my.id) — MySQL/MariaDB
# ============================================
# Uncomment below and comment out PostgreSQL section above for production.
#
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=ibentmyi_app_core
# DB_USERNAME=app_core
# DB_PASSWORD=CHANGE_ME
#
# CRM_DB_DATABASE=ibentmyi_app_crm
# CRM_DB_USERNAME=app_crm
# CRM_DB_PASSWORD=CHANGE_ME
#
# DYNAMIC_FORM_DB_DATABASE=ibentmyi_app_dynamic_form
# DYNAMIC_FORM_DB_USERNAME=app_dynamic_form
# DYNAMIC_FORM_DB_PASSWORD=CHANGE_ME
#
# ERP_DB_DATABASE=ibentmyi_app_erp
# ERP_DB_USERNAME=app_erp
# ERP_DB_PASSWORD=CHANGE_ME
